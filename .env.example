# Flood Predictor - Environment Variables

# API Configuration
VITE_API_URL=http://localhost:8000/api/v1

# Weather APIs (optional)
OPENWEATHER_API_KEY=your_openweather_api_key
IMD_API_KEY=your_imd_api_key

# Twilio Configuration (for SMS/WhatsApp/Voice alerts)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# LiveKit Configuration (for voice alerts)
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-project.livekit.cloud

# OpenAI (for LiveKit agent)
OPENAI_API_KEY=your_openai_api_key

# Deployment
RENDER_DEPLOY_HOOK=https://api.render.com/deploy/xxx
VERCEL_TOKEN=your_vercel_token
VERCEL_ORG_ID=your_vercel_org_id
VERCEL_PROJECT_ID=your_vercel_project_id
DOCKERHUB_USERNAME=your_dockerhub_username
DOCKERHUB_TOKEN=your_dockerhub_token