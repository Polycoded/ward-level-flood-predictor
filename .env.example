# Flood Predictor - Environment Variables

# API Configuration
VITE_API_URL=http://localhost:8000/api/v1
# Comma-separated browser origins allowed to call the API (set to the Vercel URL in production)
CORS_ORIGINS=*

# Storage (SQLite locally, Postgres on Render)
DATABASE_URL=sqlite:///./flood.db

# Everything we send during the hackathon is an exercise. Set false only with authority.
EXERCISE_MODE=true

# Scheduler: every 15 min, fetch Open-Meteo and create pending alerts for officials.
ENABLE_SCHEDULER=false
SCHEDULER_INTERVAL_MINUTES=15
FORECAST_HOURS=6

# Weather APIs (optional; Open-Meteo needs no key)
OPENWEATHER_API_KEY=your_openweather_api_key
IMD_API_KEY=your_imd_api_key

# Twilio Configuration (SMS fallback / voice)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_SMS_FALLBACK=true

# OpenWA (unofficial WhatsApp Web bridge). Leave base URL empty to simulate sends.
# Risk: the WhatsApp number can be banned. Use a dedicated SIM, inbound opt-in, pacing.
OPENWA_BASE_URL=
OPENWA_API_KEY=
OPENWA_SESSION=default
OPENWA_WEBHOOK_SECRET=
OPENWA_MIN_INTERVAL_SECONDS=3
OPENWA_MAX_INTERVAL_SECONDS=5
OPENWA_MAX_RETRIES=3

# Web Push (VAPID). Generate with:  python -m py_vapid --gen
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:alerts@example.org

# Encrypts WhatsApp/phone identifiers at rest. Use a long random passphrase or a
# 44-character Fernet key; never commit the real value.
PHONE_ENCRYPTION_KEY=

# Abuse protection
SUBSCRIPTION_RATE_LIMIT_PER_MINUTE=20
WEBHOOK_RATE_LIMIT_PER_MINUTE=120

# Alert thresholds (Mit owns authoritative values in model/alert_rules.py)
MIN_WATCH_RAINFALL_MM=20
MIN_WARNING_RAINFALL_MM=40
HYSTERESIS_HOURS=6
MAX_ALERTS_PER_CYCLE=50

# LiveKit Configuration (for voice alerts)
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-project.livekit.cloud

# OpenAI (for LiveKit agent)
OPENAI_API_KEY=your_openai_api_key

# LiveKit voice agent models (optional overrides; see docs/voice.md)
VOICE_STT_MODEL=gpt-4o-mini-transcribe
VOICE_LLM_MODEL=gpt-4.1-mini
VOICE_TTS_MODEL=gpt-4o-mini-tts
VOICE_TTS_VOICE=alloy

# Deployment
RENDER_DEPLOY_HOOK=https://api.render.com/deploy/xxx
VERCEL_TOKEN=your_vercel_token
VERCEL_ORG_ID=your_vercel_org_id
VERCEL_PROJECT_ID=your_vercel_project_id
DOCKERHUB_USERNAME=your_dockerhub_username
DOCKERHUB_TOKEN=your_dockerhub_token

# Frontend (web/), read at build time
# VITE_USE_MOCK=true              # force the offline mock
# VITE_SENTRY_DSN=                # enable Sentry error reporting
# VITE_ENABLE_CROWD_REPORTS=true  # show the Tier 3 crowd-report preview
# VITE_VAPID_PUBLIC_KEY=        # Web Push public key (backend holds the private key)
# VITE_WHATSAPP_NUMBER=         # OpenWA alert number, digits with country code, e.g. 9198xxxxxxxx
# VITE_ENABLE_SW=true           # register the service worker in npm run dev
